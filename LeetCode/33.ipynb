   "source": [
    "1. Brute force"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "9e4e5bd3",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "4"
      ]
     },
     "execution_count": 9,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "nums = [4,5,6,7,0,1,2]\n",
    "target = 0\n",
    "\n",
    "def search_rotated(nums:list[int],target:int)->int:\n",
    "    for i in range(len(nums)):\n",
    "        if nums[i]==target:\n",
    "            return i   \n",
    "    return -1\n",
    "search_rotated(nums,target)"
   ]
